# Port for the local/server process (optional)
PORT=3000

# Where form submissions are delivered (required — set at least one)
MAIL_TO=charter@yourdomain.com
ENQUIRY_TO_EMAIL=charter@yourdomain.com

# Optional public contact address for mailto: links on the site (update index.html if different)
CONTACT_EMAIL=charter@yourdomain.com

# SMTP (Office 365 — requires SMTP AUTH enabled by IT)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password-or-mail-password
SMTP_FROM="Lady Marcelle Website <your-email@yourdomain.com>"
