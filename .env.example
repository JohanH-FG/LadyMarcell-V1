# Port for the local/server process (optional)
PORT=3000

# Where form submissions should be delivered
MAIL_TO=hattinghj@feenstragroup.co.za
ENQUIRY_TO_EMAIL=hattinghj@feenstragroup.co.za

# Option A — Resend (recommended if Office 365 SMTP is blocked)
# Sign up at https://resend.com, create an API key, and paste it below.
RESEND_API_KEY=
RESEND_FROM="Lady Marcelle Website <onboarding@resend.dev>"

# Option B — SMTP (Office 365 — requires SMTP AUTH enabled by IT)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@feenstragroup.co.za
SMTP_PASS=your-app-password-or-mail-password
SMTP_FROM="Lady Marcelle Website <your-email@feenstragroup.co.za>"
