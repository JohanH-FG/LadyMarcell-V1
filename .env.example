# Port for the local/server process (optional)
PORT=3000

# All form emails (enquiry + booking)
MAIL_TO=bozena@iyc.com
ENQUIRY_TO_EMAIL=bozena@iyc.com
BOOKING_TO_EMAIL=bozena@iyc.com

# Optional public contact address for mailto: links on the site (update index.html if different)
CONTACT_EMAIL=enquiries@ladymarcelle.co.za

# SMTP — ladymarcelle.co.za mail host
SMTP_HOST=smtp.ladymarcelle.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=enquiries@ladymarcelle.co.za
SMTP_PASS=your-mailbox-password
SMTP_FROM="Lady Marcelle Website <enquiries@ladymarcelle.co.za>"

# Shared hosting (e.g. host-h.net) may use a wildcard cert — set false if SSL hostname mismatches
SMTP_TLS_REJECT_UNAUTHORIZED=false
